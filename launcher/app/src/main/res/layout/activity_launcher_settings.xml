<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher settings as a side sheet over Home, like the phone app's Look sheet: a preview of Home, picture
     cards for the style, pill segments for the numbers, switches for what shows on Home, and Done. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/settings_scrim">

    <LinearLayout
        android:layout_width="440dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:layout_marginEnd="28dp"
        android:background="@drawable/settings_panel_bg"
        android:orientation="vertical">

        <ScrollView
            android:id="@+id/settingsScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none"
            android:fadingEdgeLength="24dp"
            android:requiresFadingEdge="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="26dp"
                android:paddingEnd="26dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <View
                    android:layout_width="44dp"
                    android:layout_height="4dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/settings_handle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/look_title"
                    android:textColor="#FFFFFFFF"
                    android:fontFamily="@string/font_medium"
                    android:textSize="22sp" />

                <!-- A snapshot of Home taken as the sheet opened. -->
                <ImageView
                    android:id="@+id/preview"
                    android:layout_width="match_parent"
                    android:layout_height="216dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/preview_frame"
                    android:padding="1dp"
                    android:scaleType="centerCrop"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/styleDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="#A6FFFFFF"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp" />

                <TextView style="@style/SettingsHeading" android:text="@string/style_heading" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <LinearLayout android:id="@+id/styleClassic" style="@style/StyleCard">
                        <View style="@style/StyleThumb" android:background="@drawable/style_thumb_classic" />
                        <TextView style="@style/StyleLabel" android:text="@string/style_classic" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/styleCalm" style="@style/StyleCard">
                        <View style="@style/StyleThumb" android:background="@drawable/style_thumb_calm" />
                        <TextView style="@style/StyleLabel" android:text="@string/style_calm" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/styleGlass" style="@style/StyleCard" android:layout_marginEnd="0dp">
                        <View style="@style/StyleThumb" android:background="@drawable/style_thumb_glass" />
                        <TextView style="@style/StyleLabel" android:text="@string/style_glass" />
                    </LinearLayout>
                </LinearLayout>

                <TextView style="@style/SettingsHeading" android:text="@string/columns_label" />

                <LinearLayout style="@style/SegmentTrack">
                    <TextView android:id="@+id/columns4" style="@style/SegmentChoice" android:text="4" />
                    <TextView android:id="@+id/columns5" style="@style/SegmentChoice" android:text="5" />
                    <TextView android:id="@+id/columns6" style="@style/SegmentChoice" android:text="6" />
                    <TextView android:id="@+id/columns7" style="@style/SegmentChoice" android:text="7" />
                </LinearLayout>

                <TextView style="@style/SettingsHeading" android:text="@string/rows_below_dock_label" />

                <LinearLayout style="@style/SegmentTrack">
                    <TextView android:id="@+id/rows0" style="@style/SegmentChoice" android:text="0" />
                    <TextView android:id="@+id/rows1" style="@style/SegmentChoice" android:text="1" />
                    <TextView android:id="@+id/rows2" style="@style/SegmentChoice" android:text="2" />
                    <TextView android:id="@+id/rows3" style="@style/SegmentChoice" android:text="3" />
                </LinearLayout>

                <TextView style="@style/SettingsHeading" android:text="@string/dock_opacity_label" />

                <LinearLayout style="@style/SegmentTrack">
                    <TextView android:id="@+id/dock100" style="@style/SegmentChoice" android:text="100%" />
                    <TextView android:id="@+id/dock70" style="@style/SegmentChoice" android:text="70%" />
                    <TextView android:id="@+id/dock50" style="@style/SegmentChoice" android:text="50%" />
                    <TextView android:id="@+id/dock30" style="@style/SegmentChoice" android:text="30%" />
                </LinearLayout>

                <TextView style="@style/SettingsHeading" android:text="@string/on_home_heading" />

                <TextView android:id="@+id/showWeatherChoice" style="@style/ToggleRow"
                    android:drawableStart="@drawable/ic_cloud" android:text="@string/show_weather" />
                <TextView android:id="@+id/showF1Choice" style="@style/ToggleRow"
                    android:drawableStart="@drawable/ic_flag" android:text="@string/show_f1" />
                <TextView android:id="@+id/showFootballChoice" style="@style/ToggleRow"
                    android:drawableStart="@drawable/ic_football" android:text="@string/show_football" />

                <TextView style="@style/SettingsHeading" android:text="@string/more_heading" />

                <TextView android:id="@+id/reorderChoice" style="@style/NavRow" android:text="@string/reorder"
                    android:visibility="gone" />
                <TextView android:id="@+id/wallpaperChoice" style="@style/NavRow" />
                <TextView android:id="@+id/animationsChoice" style="@style/NavRow" />
                <TextView android:id="@+id/advancedChoice" style="@style/NavRow" />
                <TextView android:id="@+id/openOnStartChoice" style="@style/NavRow" android:visibility="gone" />
                <TextView android:id="@+id/followThemeChoice" style="@style/NavRow" android:text="@string/follow_theme" />
                <TextView android:id="@+id/defaultHomeChoice" style="@style/NavRow" android:text="@string/home_settings" />
                <TextView android:id="@+id/tvSettingsChoice" style="@style/NavRow" android:text="@string/tv_settings" />
            </LinearLayout>
        </ScrollView>

        <TextView
            android:id="@+id/doneChoice"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginStart="26dp"
            android:layout_marginEnd="26dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/done_button_bg"
            android:gravity="center"
            android:text="@string/done"
            android:textColor="#FF111214"
            android:textSize="17sp"
            android:fontFamily="@string/font_medium"
            android:focusable="true"
            android:clickable="true" />
    </LinearLayout>
</FrameLayout>
