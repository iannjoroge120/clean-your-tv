<?xml version="1.0" encoding="utf-8"?>
<!-- An on/off switch drawn at the end of a toggle row; the row's selected state is "on". -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item android:width="40dp" android:height="22dp"><shape><solid android:color="#FFFFFFFF" /><corners android:radius="11dp" /></shape></item>
            <item android:width="16dp" android:height="16dp" android:left="21dp" android:top="3dp"><shape android:shape="oval"><solid android:color="#FF17191D" /></shape></item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:width="40dp" android:height="22dp"><shape><solid android:color="#40FFFFFF" /><corners android:radius="11dp" /></shape></item>
            <item android:width="16dp" android:height="16dp" android:left="3dp" android:top="3dp"><shape android:shape="oval"><solid android:color="#FFFFFFFF" /></shape></item>
        </layer-list>
    </item>
</selector>
